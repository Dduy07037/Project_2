# CodeGrapher -> Neo4j Aura connection
# Copy these values to the runtime environment that starts MCP server user-CodeGrapher.

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-secret
NEO4J_DATABASE=neo4j

# Optional resilience tuning for cloud latency
NEO4J_MAX_CONNECTION_POOL_SIZE=100
NEO4J_CONNECTION_TIMEOUT_SECONDS=15
